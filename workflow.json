    {
      "parameters": {
        "promptType": "define",
        "text": "=Read the following incoming email and write a professional reply.\n\nIncoming email:\n\n{{ $json.snippet }}\n\nCreate a natural and appropriate reply to the sender.\n\nDo NOT send the email.\nOnly create the reply draft.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a helpful assistantYou are an AI Email Reply Assistant.\n\nYour job is to read incoming emails and create reply drafts.\n\nRules:\n\n1. Carefully understand the incoming email.\n2. Write a clear, natural and professional reply.\n3. Match the tone of the original email.\n4. Do not invent information.\n5. Do not make promises on behalf of the user.\n6. Keep the reply concise and relevant.\n7. Do not send emails.\n8. Your only job is to create a reply draft.\n9. The user must review and explicitly approve the reply before it is sent.\n10. Never assume that the user has approved a reply.\n\nAlways create a reply that the user can review before sending."
        }
      },
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        224,
        0
      ],
      "id": "0ffc473d-787f-42ba-ae38-03574a562d44",
      "name": "AI Agent"
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"subject\": {\n      \"type\": \"string\",\n      \"description\": \"The subject line of the email reply\"\n    },\n    \"body\": {\n      \"type\": \"string\",\n      \"description\": \"The complete body of the email reply\"\n    }\n  },\n  \"required\": [\n    \"subject\",\n    \"body\"\n  ]\n}"
      },
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        400,
        208
      ],
      "id": "3e600a37-1d98-4810-8f7d-8a85d965103c",
